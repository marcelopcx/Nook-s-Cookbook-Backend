{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.id,\n            p.puntuacion,\n            p.comentario,\n            p.id_usuario,\n            u.username,\n            p.id_receta\n        FROM puntuacion_receta p\n        INNER JOIN usuario u ON u.id = p.id_usuario\n        WHERE p.id_receta = $1\n        ORDER BY p.id DESC\n        ",
