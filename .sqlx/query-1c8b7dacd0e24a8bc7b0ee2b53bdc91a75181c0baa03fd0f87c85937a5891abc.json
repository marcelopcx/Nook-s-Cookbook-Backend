  "query": "\n        SELECT\n            i.id,\n            i.nombre,\n            i.id_tipo_ingrediente,\n            ti.nombre AS tipo_nombre\n        FROM ingrediente i\n        LEFT JOIN tipo_ingrediente ti ON ti.id = i.id_tipo_ingrediente\n        ORDER BY LOWER(i.nombre)\n        ",
