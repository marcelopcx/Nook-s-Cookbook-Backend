  "query": "\n        SELECT\n            ul.id_logro,\n            l.nombre,\n            l.descripcion,\n            ul.fecha_obtenido\n        FROM usuario_logro ul\n        INNER JOIN logro l ON l.id = ul.id_logro\n        WHERE ul.id_usuario = $1 AND ul.id_logro = $2\n        ",
