  "query": "\n        SELECT\n            u.id,\n            u.username,\n            sg.fecha_seguido\n        FROM seguidor_grupo sg\n        INNER JOIN usuario u ON u.id = sg.id_usuario\n        WHERE sg.id_grupo = $1\n        ORDER BY sg.fecha_seguido DESC\n        ",
