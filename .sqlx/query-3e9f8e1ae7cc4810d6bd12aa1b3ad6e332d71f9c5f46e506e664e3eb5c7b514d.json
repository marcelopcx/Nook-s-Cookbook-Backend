  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            u.id,\n            u.nombre,\n            u.id_tipo_utensilio,\n            tu.nombre AS tipo_nombre\n        FROM utensilio u\n        LEFT JOIN tipo_utensilio tu ON tu.id = u.id_tipo_utensilio\n        ORDER BY LOWER(u.nombre)\n        ",
