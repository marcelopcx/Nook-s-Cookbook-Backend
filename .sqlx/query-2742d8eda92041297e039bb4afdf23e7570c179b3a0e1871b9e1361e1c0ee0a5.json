{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            r.id,\n            r.nombre,\n            r.descripcion,\n            r.raciones,\n            r.tiempo,\n            r.promedio_puntuacion::float8 AS \"promedio_puntuacion?: f64\",\n            r.dificultad,\n            r.imagen,\n            r.id_usuario_creador\n        FROM receta r\n        INNER JOIN receta_grupo rg ON rg.id_receta = r.id\n        WHERE rg.id_grupo = $1\n        ORDER BY LOWER(r.nombre)\n        ",
