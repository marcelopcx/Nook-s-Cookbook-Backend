  "query": "\n        SELECT\n            u.id,\n            u.username,\n            u.public,\n            p.nombre,\n            p.apellido,\n            p.correo,\n            p.telefono\n        FROM usuario u\n        INNER JOIN persona p ON p.id = u.id_persona\n        WHERE u.id = $1\n        ",
