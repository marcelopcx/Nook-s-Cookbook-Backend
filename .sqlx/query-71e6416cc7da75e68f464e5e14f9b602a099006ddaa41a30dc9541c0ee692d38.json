  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            r.id,\n            r.nombre,\n            r.descripcion,\n            r.raciones,\n            r.tiempo,\n            r.promedio_puntuacion::float8 AS \"promedio_puntuacion?: f64\",\n            r.dificultad,\n            r.imagen,\n            r.id_usuario_creador,\n            u.username AS creador_username\n        FROM receta r\n        INNER JOIN usuario u ON u.id = r.id_usuario_creador\n        WHERE r.id = $1\n        ",
