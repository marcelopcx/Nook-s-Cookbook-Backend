  "query": "\n        UPDATE grupo\n        SET\n            nombre = COALESCE($1, nombre),\n            descripcion = COALESCE($2, descripcion),\n            publico = COALESCE($3, publico)\n        WHERE id = $4\n        RETURNING id, nombre, descripcion, publico, fecha_creacion, id_usuario_creador\n        ",
